[Unit]
Description=Math bot study service
After=network-online.target
Wants=network-online.target

[Service]
User=mathbot
WorkingDirectory=/srv/math-bot/current
Environment=BOT_ENV=production
ExecStart=/usr/bin/node dist/service/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/math-bot/shared/data

[Install]
WantedBy=multi-user.target
