[Unit]
Description=Math bot Discord gateway
After=network-online.target math-bot-ai.service
Wants=network-online.target math-bot-ai.service

[Service]
User=mathbot
WorkingDirectory=/srv/math-bot/current
Environment=BOT_ENV=production
ExecStart=/usr/local/bin/bun dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/math-bot/shared/data
ProtectHome=true

[Install]
WantedBy=multi-user.target
