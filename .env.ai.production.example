AI_SERVICE_TOKEN=
AI_PORT=8788
AI_DATABASE=data/production.sqlite
AI_CONCURRENCY=1
COACH_RESERVED_SLOTS=0
COACH_BORROW_RESERVED=false
AI_MAX_QUEUE=50
AI_TIMEOUT_SECONDS=600
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_API_KEY=
INFERENCE_VISION=false
# Keep false for templates without native tool support (including current Phi).
INFERENCE_NATIVE_TOOLS=false
PYTHON_EXECUTABLE=python3
TAVILY_API_KEY=
PYTHON_SANDBOX_ENABLED=false
PYTHON_SANDBOX_IMAGE=math-bot-python:local

# Opt-in conservative local Phi / external model routing. No production default change.
COGNITIVE_ROUTING=false
# External compatible chat endpoint must use HTTPS. Configure privately before enabling.
EXTERNAL_INFERENCE_BASE_URL=
EXTERNAL_INFERENCE_MODEL=
EXTERNAL_INFERENCE_API_KEY=
EXTERNAL_INFERENCE_VISION=false
EXTERNAL_INFERENCE_NATIVE_TOOLS=false

# --- OpenAI provider (official Responses API). AI_PROVIDER=legacy keeps the
# existing local/external (e.g. Groq) behaviour exactly. Never commit a real key.
AI_PROVIDER=legacy
OPENAI_API_KEY=
OPENAI_LIGHT_MODEL=gpt-6-luna
OPENAI_ADVANCED_MODEL=gpt-6.1-sol
# Efforts must be supported by the model (Sol: low|medium|high|xhigh|max; Luna also none).
OPENAI_LIGHT_EFFORT=medium
OPENAI_ADVANCED_EFFORT=high
OPENAI_MAX_EFFORT=xhigh
# false = always use the light model unless !deep / !max is used.
OPENAI_ROUTING=true
# none | external (transient OpenAI failures only; requires EXTERNAL_INFERENCE_NATIVE_TOOLS=true)
OPENAI_FALLBACK=none
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
# Output caps include hidden reasoning tokens.
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_ADVANCED_MAX_OUTPUT_TOKENS=16000
OPENAI_MAX_TIER_MAX_OUTPUT_TOKENS=32000
OPENAI_MAX_INPUT_CHARS=120000
OPENAI_CONCURRENCY=2
OPENAI_USER_REQUESTS_PER_HOUR=20
OPENAI_USER_ADVANCED_PER_DAY=5
OPENAI_USER_MAX_PER_DAY=1
# Local *estimated* spend ceilings in USD (UTC day / all time). 0 disables paid calls.
OPENAI_DAILY_BUDGET_USD=1
OPENAI_TOTAL_BUDGET_USD=40
# Admin overrides (empty = automatic): OPENAI_FORCE_TIER=light|advanced, OPENAI_FORCE_EFFORT=<effort>
OPENAI_FORCE_TIER=
OPENAI_FORCE_EFFORT=
# Optional price/capability overrides, USD per 1M tokens:
# OPENAI_PRICING_JSON={"gpt-6-luna":{"input":0.10,"cachedInput":0.01,"output":0.50}}
