# OpenAI study service. Set AI_PROVIDER=openai only when the deployment checks pass.
AI_PROVIDER=legacy
OPENAI_API_KEY=
OPENAI_ALLOWED_MODELS=luna,terra,sol
OPENAI_LUNA_MODEL=gpt-6-luna
OPENAI_TERRA_MODEL=gpt-6.1-terra
OPENAI_SOL_MODEL=gpt-6.2-sol
OPENAI_LUNA_EFFORT=low
OPENAI_LUNA_MAX_EFFORT=high
OPENAI_TERRA_EFFORT=medium
OPENAI_SOL_EFFORT=medium
OPENAI_TERRA_MAX_EFFORT=xhigh
OPENAI_SOL_MAX_EFFORT=xhigh
# Independent proof review before publication: sol (falls back to luna without sol quota), luna or off.
OPENAI_PROOF_REVIEW=sol
OPENAI_PROOF_REVIEW_EFFORT=medium
OPENAI_PROOF_REVIEWS=2
OPENAI_LUNA_MAX_OUTPUT_TOKENS=4000
OPENAI_TERRA_MAX_OUTPUT_TOKENS=6000
OPENAI_SOL_MAX_OUTPUT_TOKENS=8000
OPENAI_REQUEST_BUDGET_USD=0.02
OPENAI_TERRA_REQUEST_BUDGET_USD=0.08
OPENAI_SOL_REQUEST_BUDGET_USD=0.10
OPENAI_BOTH_REQUEST_BUDGET_USD=0.15
OPENAI_SEVEN_REQUEST_BUDGET_USD=0.15
OPENAI_SYSTEM_REQUEST_BUDGET_USD=0.05
OPENAI_DAILY_BUDGET_USD=1
OPENAI_TOTAL_BUDGET_USD=40
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2
OPENAI_MAX_INPUT_CHARS=160000
OPENAI_CONCURRENCY=6
OPENAI_USER_REQUESTS_PER_HOUR=30
OPENAI_USER_SOL_PER_DAY=4
OPENAI_USER_TERRA_PER_DAY=4
OPENAI_SEVEN_PER_DAY=3
OPENAI_USER_SEVEN_PER_DAY=1
AI_SEVEN_AGENT_CHANCE=0.0001
AI_SOFT_ROUNDS=32
AI_HARD_ROUNDS=64
AI_TOOL_CONCURRENCY=4
AI_IMAGE_CORRECTIONS=5
AI_STREAMING=true

AI_SERVICE_TOKEN=
AI_PORT=8788
AI_DATABASE=data/production.sqlite
AI_CONCURRENCY=3
COACH_RESERVED_SLOTS=0
COACH_BORROW_RESERVED=false
AI_MAX_QUEUE=50
AI_TIMEOUT_SECONDS=600
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_API_KEY=
INFERENCE_VISION=false
# Keep false for templates without native tool support (including current Phi).
INFERENCE_NATIVE_TOOLS=false
# Optional stronger inference; keep routing off until key and quality review exist.
COGNITIVE_ROUTING=false
EXTERNAL_INFERENCE_PROVIDER=groq
EXTERNAL_INFERENCE_BASE_URL=https://api.groq.com/openai/v1
EXTERNAL_INFERENCE_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
PYTHON_EXECUTABLE=python3
TAVILY_API_KEY=
PYTHON_SANDBOX_ENABLED=false
PYTHON_SANDBOX_IMAGE=math-bot-python:local

# Image requests only; uses the existing Groq account. Text routing stays unchanged.
# VISION_INFERENCE_MODEL=qwen/qwen3.8-27b
