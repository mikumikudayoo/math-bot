{
  "name": "math-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "commands:json": "tsx src/scripts/commands-json.ts",
    "commands:deploy:dev": "BOT_ENV=development tsx src/scripts/deploy-dev.ts",
    "commands:deploy:production": "BOT_ENV=production tsx src/scripts/deploy-dev.ts --confirm-production",
    "test": "tsx --test tests/*.test.ts",
    "service:dev": "tsx watch src/service/server.ts",
    "service:start": "node dist/service/server.js",
    "setup:local": "tsx src/scripts/setup-local.ts",
    "benchmark": "tsx src/scripts/benchmark.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "ipaddr.js": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "4.23.13",
    "typescript": "~5.9.3"
  }
}
