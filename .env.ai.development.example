AI_SERVICE_TOKEN=
AI_PORT=8787
AI_DATABASE=data/development.sqlite
AI_CONCURRENCY=1
COACH_RESERVED_SLOTS=0
COACH_BORROW_RESERVED=false
AI_MAX_QUEUE=50
AI_TIMEOUT_SECONDS=600
# OpenAI-compatible chat completions base URL; include /v1 if required.
# No model or provider is selected. Remote endpoints must use HTTPS.
INFERENCE_BASE_URL=
INFERENCE_MODEL=
INFERENCE_API_KEY=
INFERENCE_VISION=false
# Keep false for templates without native tool support (including current Phi).
INFERENCE_NATIVE_TOOLS=false
PYTHON_EXECUTABLE=python3
TAVILY_API_KEY=
PYTHON_SANDBOX_ENABLED=false
PYTHON_SANDBOX_IMAGE=math-bot-python:local

# Opt-in conservative local Phi / external model routing. No production default change.
COGNITIVE_ROUTING=false
# External compatible chat endpoint must use HTTPS. Configure privately before enabling.
EXTERNAL_INFERENCE_BASE_URL=
EXTERNAL_INFERENCE_MODEL=
EXTERNAL_INFERENCE_API_KEY=
EXTERNAL_INFERENCE_VISION=false
EXTERNAL_INFERENCE_NATIVE_TOOLS=false
