# Current production: /opt/math-bot, Bun, PM2 under mathbot. Keep a separate dev Discord app.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
AI_SERVICE_URL=http://127.0.0.1:8788
AI_SERVICE_TOKEN=
# Static tester IDs, merged with owner-managed runtime testers. Both empty denies everyone.
AI_TESTER_USER_IDS=
MESSAGE_FEATURES_ENABLED=false
COACH_ROLE_IDS=
COACH_USER_IDS=
MOD_LOG_CHANNEL_ID=
# Current persistent storage: retain this directory across in-place updates.
REMINDER_DB_PATH=/opt/math-bot/data/reminders.production.sqlite

# Private tester registry and admin audit; NEVER share with a /sql database.
ADMIN_DB_PATH=/opt/math-bot/data/admin.production.sqlite
# Bounded SQL worker uses only the Python standard library.
ADMIN_PYTHON_EXECUTABLE=python3
