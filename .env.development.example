# Copy to .env.development. Use ONLY the development Discord app.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
AI_SERVICE_URL=http://127.0.0.1:8787
AI_SERVICE_TOKEN=
# Static tester IDs, merged with owner-managed runtime testers. Both empty denies everyone.
AI_TESTER_USER_IDS=
# Enable Message Content intent in the portal BEFORE setting this true.
MESSAGE_FEATURES_ENABLED=false
COACH_ROLE_IDS=
COACH_USER_IDS=
MOD_LOG_CHANNEL_ID=
# Bot-owned reminders, independent from AI and QOTD databases.
REMINDER_DB_PATH=data/reminders.development.sqlite

# Private tester registry and admin audit; NEVER share with a /sql database.
ADMIN_DB_PATH=data/admin.development.sqlite
# Bounded SQL worker uses only the Python standard library.
ADMIN_PYTHON_EXECUTABLE=python3
