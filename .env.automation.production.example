# Copy privately to .env.automation.production; never commit populated values.
ANNOUNCEMENT_AUTOMATION_ENABLED=false
ANNOUNCEMENT_AUTO_SEND_ENABLED=false
ANNOUNCEMENT_DB_PATH=/opt/math-bot/data/announcements.production.sqlite
ANNOUNCEMENT_ASSET_PATH=/opt/math-bot/data/announcement-assets.production
ANNOUNCEMENT_POLICY_PATH=/opt/math-bot/data/announcement-policy.production.json
ANNOUNCEMENT_POLL_SECONDS=120
GMAIL_ACCOUNT_ID=primary
GMAIL_QUERY=
GMAIL_ORGANIZER_SENDERS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GROQ_API_KEY=
EXTERNAL_INFERENCE_MODEL=openai/gpt-oss-120b
